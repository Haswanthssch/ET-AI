# AURA-EPC Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values

# --- REQUIRED ---
GROQ_API_KEY=your_groq_api_key_here

# --- MODEL CONFIGURATION ---
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=qwen3.6-27b
GROQ_VISION_FALLBACK_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- DATA PATHS ---
DATA_DIR=./data
MODELS_DIR=./data/models
VECTOR_INDEX_PATH=./data/vector_index

# --- SERVER ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- UPTIME INSTITUTE THRESHOLDS ---
TIER_I_AVAILABILITY=99.671
TIER_II_AVAILABILITY=99.741
TIER_III_AVAILABILITY=99.982
TIER_IV_AVAILABILITY=99.995
